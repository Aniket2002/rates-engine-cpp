{
  "version": 6,
  "configurePresets": [
    {"name": "release", "generator": "Ninja", "binaryDir": "${sourceDir}/build/release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "debug", "inherits": "release", "binaryDir": "${sourceDir}/build/debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "sanitizers", "inherits": "debug", "binaryDir": "${sourceDir}/build/sanitizers", "cacheVariables": {"RATES_SANITIZERS": "ON"}}
  ],
  "buildPresets": [{"name": "release", "configurePreset": "release"}, {"name": "debug", "configurePreset": "debug"}, {"name": "sanitizers", "configurePreset": "sanitizers"}],
  "testPresets": [{"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}}, {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}}, {"name": "sanitizers", "configurePreset": "sanitizers", "output": {"outputOnFailure": true}}]
}
